                    <?php
                    $panel_url = 'https://' . (isset($module_row->meta->host_name) ? $module_row->meta->host_name : '') . ':' . (isset($module_row->meta->port) ? $module_row->meta->port : '8443') . '/jabali-panel';
                    ?>
                    <a href="<?php echo $this->Html->safe($panel_url);?>" target="_blank" rel="noopener"><?php echo $this->Html->safe($panel_url);?></a>
                </td>
