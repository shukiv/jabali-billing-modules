        <table class="table">
            <tr class="heading_row">
                <td><?php $this->_('Jabali.service_info.username');?></td>
                <td><?php $this->_('Jabali.service_info.domain');?></td>
                <td class="last"><?php $this->_('Jabali.service_info.panel_url');?></td>
            </tr>
            <tr>
                <td><?php echo (isset($service_fields->jabali_username) ? $this->Html->safe($service_fields->jabali_username) : null);?></td>
                <td><?php echo (isset($service_fields->jabali_domain) ? $this->Html->safe($service_fields->jabali_domain) : null);?></td>
